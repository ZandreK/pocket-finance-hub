# A versão demo roda 100% no navegador (localStorage), sem precisar de backend.
#
# Para habilitar o modo cloud (Supabase), copie este arquivo para ".env" e
# preencha com os valores do seu projeto. O ".env" está no .gitignore.
# Use SEMPRE a chave "anon/public" no frontend — nunca a service_role.

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica
